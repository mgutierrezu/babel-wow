# Configuración de Traductor WoW.
# Copia este archivo como ".env" y edita los valores. Se lee al abrir el programa.
# Formato: CLAVE=valor, una por línea. Las líneas que empiezan con # son comentarios.
# Una variable de entorno de Windows con el mismo nombre tiene prioridad sobre este archivo.

# --- Conexión con Ollama ---
# Usa 127.0.0.1 y no "localhost": en Windows "localhost" agrega unos 2 segundos por traducción.
OLLAMA_URL=http://127.0.0.1:11434
# Modelo que traduce. Se cambia desde la ventana del programa, que ofrece:
#   gemma3:4b     recomendado, 3,9 GB de memoria de video
#   qwen2.5:3b    intermedio, 2,4 GB
#   qwen2.5:1.5b  liviano, 1,3 GB
# También puedes escribir aquí cualquier otro modelo de Ollama.
OLLAMA_MODELO=gemma3:4b
# Solo si tu Ollama está detrás de un servidor que pide clave (se envía como "Authorization: Bearer").
# Con Ollama local se deja vacío.
OLLAMA_API_KEY=
# true: el programa enciende Ollama al abrirse y lo apaga al salir (libera la memoria de video).
# false: usa el Ollama que ya esté abierto y no lo toca.
OLLAMA_ENCENDER_Y_APAGAR=true
# Espera máxima por traducción. La primera demora más porque carga el modelo.
OLLAMA_TIMEOUT_SEGUNDOS=90
# 0 da siempre la misma traducción para el mismo mensaje; más alto es más variado.
OLLAMA_TEMPERATURA=0
# Tiempo que Ollama deja el modelo cargado en memoria (ejemplos: 1m, 30m, 2h).
OLLAMA_MANTENER_MODELO=30m

# --- Portapapeles ---
# Cada cuántos milisegundos se revisa el portapapeles.
PORTAPAPELES_INTERVALO_MS=300

# --- Ventana flotante ---
# Segundos antes de ocultarse sola.
VENTANA_SEGUNDOS_VISIBLE=30
# De 0.2 (casi invisible) a 1.0 (opaca).
VENTANA_OPACIDAD=0.9
# Ancho en píxeles.
VENTANA_ANCHO=440
VENTANA_FUENTE=Segoe UI
VENTANA_TAMANO_FUENTE=11

# --- Archivos (rutas relativas a la carpeta del programa, o absolutas) ---
PROMPT_ARCHIVO=prompt.txt
# Instrucciones para traducir al inglés lo que escribes con /twow.
PROMPT_ENVIAR_ARCHIVO=prompt_en.txt
# true o false.
HISTORIAL_ACTIVO=true
HISTORIAL_ARCHIVO=traducciones.txt
